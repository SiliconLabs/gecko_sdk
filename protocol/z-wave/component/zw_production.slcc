id: zw_production
label: Z-Wave Production
category: Z-Wave
description: >
  This component includes different libraries for 700 series processor types, for
  end devices, and for controller and portable controller devices.
package: Z-Wave
quality: production
requires:
  - name: zw_zpal_quality_mode
provides:
  - name: zw_production
  - name: zw_quality_mode
recommends:
  - id: zw_zpal_production
library:
  # Release build
  ## End devices
  ### Series 1
  # Zniffer library for non-PTI Zniffer app on EFR32ZG14 devices
  - path: protocol/z-wave/ZWave/lib/libZWaveZniffer_ZG14.a
    condition: [device_series_1, zw_end_device, zw_appshw_zniffer, device_sdid_95]
  # Default library for all other cases
  - path: protocol/z-wave/ZWave/lib/libZWaveSlave_700s.a
    condition: [device_series_1, zw_end_device]
  ## Controllers
  ### Series 1
  - path: protocol/z-wave/ZWave/lib/libZWaveController_700s.a
    condition: [device_series_1, zw_role_type_central_static_controller]

  # The Gecko SDK no longer supports 800 series devices. Please use the Simplicity SDK instead.
