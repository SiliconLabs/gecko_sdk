id: zw_series
label: Z-Wave Series
category: Z-Wave
description: >
  This component describes the processor series and provide the relevant defines, such as ZWAVE_SERIES_700.
package: Z-Wave
quality: production
define:
  - name: ZWAVE_SERIES_700
    condition: [device_sdid_89]
  - name: ZWAVE_SERIES_700
    condition: [device_sdid_95]
  # The Gecko SDK no longer supports 800 series devices. Please use the Simplicity SDK instead.
provides:
  - name: zw_series
